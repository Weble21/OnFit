# Copy to .env at the repository root. Never commit .env or real credentials.
# Local PostgreSQL (the default Compose database uses this password).
DB_PASSWORD=onfit_local

# Local Keycloak admin account. Choose your own strong password before first start.
ONFIT_KC_ADMIN_USER=admin
ONFIT_KC_ADMIN_PASSWORD=

# Optional social providers. Fill both values for each provider you enable.
ONFIT_GOOGLE_CLIENT_ID=
ONFIT_GOOGLE_CLIENT_SECRET=
ONFIT_NAVER_CLIENT_ID=
ONFIT_NAVER_CLIENT_SECRET=
ONFIT_KAKAO_CLIENT_ID=
ONFIT_KAKAO_CLIENT_SECRET=
# Optional scope overrides. Kakao needs each item enabled under the app's consent items (else KOE205).
# ONFIT_KAKAO_SCOPE=openid profile_nickname profile_image
# ONFIT_NAVER_SCOPE=openid

# Optional local overrides for ./gradlew bootRun.
# ONFIT_AUTH_ISSUER=http://localhost:8081/realms/onfit
# ONFIT_AUTH_AUDIENCE=onfit-api
# DB_URL=jdbc:postgresql://localhost:5432/onfit
# DB_USERNAME=onfit

# Work24 official API: enable only after its key and use approval are issued.
# ONFIT_INGESTION_ENABLED=false
# ONFIT_WORK24_ENABLED=false
# ONFIT_WORK24_AUTH_KEY=
# ONFIT_WORK24_PERMISSION_EVIDENCE=approval reference and permitted use, never the key
# ONFIT_WORK24_KEYWORD=개발자
# ONFIT_WORK24_MAX_PAGES=2
# ONFIT_INGESTION_ALERT_URL=https://your-private-alert-endpoint.example/path

# Backend email alerts: SMTP settings are kept on the backend, not in GitHub runner logs.
ONFIT_ALERTS_ENABLED=false
ONFIT_MAIL_FROM=
ONFIT_APP_URL=http://localhost:5173
ONFIT_SMTP_HOST=
ONFIT_SMTP_PORT=587
ONFIT_SMTP_USERNAME=
ONFIT_SMTP_PASSWORD=
# Source approval references (no keys). Set matching values on the backend and in Actions Variables.
ONFIT_SARAMIN_PERMISSION_EVIDENCE=
ONFIT_WANTED_PERMISSION_EVIDENCE=
ONFIT_JOBKOREA_PERMISSION_EVIDENCE=
ONFIT_JOBKOREA_TERMS_URL=

# Collector settings: configure GitHub Environment job-alerts as described in collector/README.md.
# These values are used by Python, not automatically by ./gradlew bootRun.
# ONFIT_BACKEND_URL=https://your-backend.example
# ONFIT_OIDC_ISSUER=https://your-keycloak.example/realms/onfit
# ONFIT_COLLECTOR_CLIENT_ID=onfit-collector
# ONFIT_COLLECTOR_CLIENT_SECRET=
# ONFIT_SARAMIN_API_KEY=
# ONFIT_WANTED_CLIENT_ID=
# ONFIT_WANTED_CLIENT_SECRET=
# ONFIT_JOBKOREA_FEED_URL=https://your-approved-partner.example/jobs
# ONFIT_JOBKOREA_FEED_TOKEN=
# Optional per-source request budgets per run and the Saramin lookback (defaults shown).
# ONFIT_SARAMIN_REQUEST_BUDGET=150
# ONFIT_WANTED_REQUEST_BUDGET=300
# ONFIT_JOBKOREA_REQUEST_BUDGET=150
# ONFIT_COLLECTOR_LOOKBACK_HOURS=72
