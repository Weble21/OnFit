# OnFit 로컬 실행용 환경변수 예시입니다.
# 이 파일을 루트에 .env로 복사한 뒤 값을 채웁니다: Copy-Item .env.example .env
# .env는 Git에서 제외됩니다. 실제 비밀값은 이 예시 파일에 넣지 마세요.
# 값 뒤에 주석을 붙이지 마세요. bootRun과 configure-social.ps1이 줄 전체를 값으로 읽습니다.
# 주석 처리된 항목은 비워 두면 괄호 안의 기본값을 사용합니다.

# ── 필수 ─────────────────────────────────────────────
# Keycloak 관리자 비밀번호. 비어 있으면 docker compose가 시작되지 않습니다.
# 이미 Keycloak 볼륨을 만들었다면 처음 사용한 값을 유지하세요.
ONFIT_KC_ADMIN_PASSWORD=
# Keycloak 관리자 계정 (기본값: admin)
# ONFIT_KC_ADMIN_USER=admin

# ── 데이터베이스 ─────────────────────────────────────
# PostgreSQL 비밀번호 (기본값: onfit_local). DB 이름과 사용자는 onfit으로 고정입니다.
DB_PASSWORD=onfit_local
# infra/compose.yaml로 DB만 띄울 때 외부 포트 (기본값: 5432)
DB_PORT=5432
# 로컬 bootRun 전용 (기본값: jdbc:postgresql://localhost:5432/onfit, onfit)
DB_URL=jdbc:postgresql://localhost:5432/onfit
DB_USERNAME=onfit

# ── 인증 (로컬 bootRun 전용) ─────────────────────────
# ONFIT_AUTH_ISSUER=http://localhost:8081/realms/onfit
# ONFIT_AUTH_AUDIENCE=onfit-api

# ── LLM 공고 구조화·직무 분석 (선택) ─────────────────
# true로 켜면 확인된 공고 텍스트와 마스킹된 프로필 항목이 Anthropic API로 전송됩니다.
ONFIT_LLM_ENABLED=false
ANTHROPIC_API_KEY=
# 사용할 Claude 모델 (기본값: claude-haiku-5-5)
AI_LLM_MODEL=claude-haiku-5-5

# ── 내부 서비스 토큰 (선택) ──────────────────────────
# 백엔드와 AI·OCR 컨테이너 사이의 공유 토큰입니다. 로컬 전용 기본값이 있습니다.
# ONFIT_AI_TOKEN=onfit-local-ai-token
# ONFIT_OCR_TOKEN=onfit-local-ocr-token

# ── OCR (선택) ───────────────────────────────────────
# paddle(기본값, 한국어 PaddleOCR) 또는 tesseract(가볍지만 정확도 낮음)
ONFIT_OCR_ENGINE=paddle

# ── 소셜 로그인 (선택) ───────────────────────────────
# 켤 로그인 버튼 목록. 바꾸면 docker compose up -d --build frontend로 다시 빌드합니다.
VITE_SOCIAL_PROVIDERS=google,naver,kakao
# 공급자 ID·Secret은 infra/keycloak/configure-social.ps1이 읽어 Keycloak에 등록합니다.
# 필요한 공급자만 채우면 됩니다. Secret을 VITE_* 변수에 넣지 마세요.
ONFIT_GOOGLE_CLIENT_ID=
ONFIT_GOOGLE_CLIENT_SECRET=
ONFIT_NAVER_CLIENT_ID=
ONFIT_NAVER_CLIENT_SECRET=
ONFIT_NAVER_SCOPE=openid
ONFIT_KAKAO_CLIENT_ID=
ONFIT_KAKAO_CLIENT_SECRET=
ONFIT_KAKAO_SCOPE=openid profile_nickname profile_image
